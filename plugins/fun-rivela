import { downloadContentFromMessage } from '@realvare/baileys'

const MESSAGES_CONFIG = {
  videoMessage: { type: 'video', ext: 'video.mp4', isAudio: false },
  imageMessage: { type: 'image', ext: 'image.jpg', isAudio: false },
  audioMessage: { type: 'audio', ext: 'audio.mp3', isAudio: true }
}

let handler = async (m, { conn }) => {
  try {
    if (!m.quoted) {
      return m.reply('*⚠️ 𝐑𝐢𝐬𝐩𝐨𝐧𝐝𝐢 𝐚 𝐮𝐧 𝐜𝐨𝐧𝐭𝐞𝐧𝐮𝐭𝐨 𝐯𝐢𝐬𝐮𝐚𝐥𝐢𝐳𝐳𝐚𝐛𝐢𝐥𝐞 𝐮𝐧𝐚 𝐬𝐨𝐥𝐚 𝐯𝐨𝐥𝐭𝐚.*')
    }

    if (!m.quoted?.viewOnce) {
      return m.reply('*⚠️ 𝐐𝐮𝐞𝐬𝐭𝐨 𝐧𝐨𝐧 𝐞̀ 𝐮𝐧 𝐜𝐨𝐧𝐭𝐞𝐧𝐮𝐭𝐨 𝐯𝐢𝐬𝐮𝐚𝐥𝐢𝐳𝐳𝐚𝐛𝐢𝐥𝐞 𝐮𝐧𝐚 𝐬𝐨𝐥𝐚 𝐯𝐨𝐥𝐭𝐚.*')
    }

    const mtype = m.quoted.mtype
    const config = MESSAGES_CONFIG[mtype]

    if (!config) {
      return m.reply('*❌ 𝐅𝐨𝐫𝐦𝐚𝐭𝐨 𝐧𝐨𝐧 𝐬𝐮𝐩𝐩𝐨𝐫𝐭𝐚𝐭𝐨.*')
    }

    let buffer
    try {
      const stream = await downloadContentFromMessage(m.quoted[mtype], config.type)
      const chunks = []
      for await (const chunk of stream) {
        chunks.push(chunk)
      }
      buffer = Buffer.concat(chunks)
    } catch {
      buffer = await m.quoted.download?.()
    }

    if (!buffer || !buffer.length) {
      return m.reply('*❌ 𝐈𝐦𝐩𝐨𝐬𝐬𝐢𝐛𝐢𝐥𝐞 𝐬𝐜𝐚𝐫𝐢𝐜𝐚𝐫𝐞 𝐢𝐥 𝐜𝐨𝐧𝐭𝐞𝐧𝐮𝐭𝐨.*')
    }

    const caption = m.quoted?.caption || ''

    if (config.isAudio) {
      await conn.sendFile(m.chat, buffer, config.ext, '', m, false, {
        mimetype: 'audio/mp4',
        ptt: m.quoted.ptt || false
      })
    } else {
      await conn.sendFile(m.chat, buffer, config.ext, caption, m)
    }

  } catch (e) {
    throw new Error(`*❌ 𝐄𝐫𝐫𝐨𝐫𝐞*\n\n${e.message || e}`)
  }
}

handler.help = ['rivela']
handler.tags = ['gruppo']
handler.command = ['readviewonce', 'rivela', 'viewonce']
handler.group = true
handler.admin = true

export default handler
